{
    "name": "curato-backend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env src/server.ts",
        "build": "tsc",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "format": "prettier --ignore-path ../.prettierignore --write .",
        "format:check": "prettier --ignore-path ../.prettierignore --check .",
        "test": "node --test tests/*.test.ts"
    },
    "dependencies": {
        "express": "^5.1.0",
        "nodemailer": "^10.6.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/nodemailer": "^8.0.2",
        "prettier": "3.10.1",
        "typescript": "~5.9.0"
    }
}
